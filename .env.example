# Document Approval & Automation System - DAAS - Production Server Environment Configuration
# Copy this file to .env on your server.

# Application & Server Settings
PROJECT_NAME="Document Approval & Automation System - DAAS"
NODE_ENV="production"
PORT=3000
HOST="0.0.0.0"
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:8085,http://localhost:3000"

# Database Connection (Strictly Microsoft SQL Server at 192.168.179.22:1443)
DB_HOST="192.168.179.22"
DB_PORT="1443"
DB_NAME="DocuFlowDB"
DB_USER="<YOUR_DB_USERNAME>"
DB_PASSWORD="<YOUR_DB_PASSWORD>"

# Full SQLAlchemy Database URL (Optional: auto-constructed from DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD)
DATABASE_URL="mssql+pyodbc://<YOUR_DB_USERNAME>:<YOUR_DB_PASSWORD>@192.168.179.22:1443/DocuFlowDB?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes"

# JWT Authentication & Session Security
SECRET_KEY="<GENERATE_RANDOM_STRONG_SECRET_KEY_MIN_32_CHARS>"
JWT_SECRET_KEY="<GENERATE_RANDOM_STRONG_SECRET_KEY_MIN_32_CHARS>"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Service M2M API Key
SERVICE_API_KEY="<GENERATE_RANDOM_M2M_API_KEY>"

# Azure AD / Microsoft Single Sign-On (SSO)
AZURE_CLIENT_ID="<YOUR_AZURE_CLIENT_ID>"
AZURE_CLIENT_SECRET="<YOUR_AZURE_CLIENT_SECRET>"
AZURE_REDIRECT_URI="http://localhost:3000/api/auth/microsoft/callback"

# SMTP Email Notification & OTP Delivery
SMTP_HOST="<company SMTP host>"
SMTP_PORT=587
SMTP_USERNAME="<company email>"
SMTP_PASSWORD="<company email password>"
SMTP_FROM="<company email>"
SMTP_SENDER_NAME="DocuFlow Security"
# Alternative alias names also supported:
# SMTP_USER="<company email>"
# SMTP_PASS="<company email password>"
# SMTP_SENDER_EMAIL="<company email>"

# SMS Gateway Configuration (Twilio, Fast2SMS, or Generic REST API)
SMS_PROVIDER="generic"
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID="DOCUFLOW"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
FAST2SMS_API_KEY=""

# File Storage & Archival Directories (Docker Volume Paths)
PDF_STORAGE_PATH="/app/stored_pdfs"
APPROVED_PDF_PATH="/app/stored_pdfs/approved"
UPLOAD_DIR="/app/uploads"
