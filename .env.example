# Strivh Professional Enterprises - DocuFlow Automation System Environment Configuration
# Copy this file to .env and configure environment parameters for your deployment.

# General Application Settings
PROJECT_NAME="DocuFlow Automation System"
ENVIRONMENT="development"  # Options: development, staging, production
LOG_LEVEL="INFO"          # Options: DEBUG, INFO, WARNING, ERROR

# Centralized Database Connection Parameters (MS SQL Server / SQLite Fallback)
DB_HOST="localhost"
DB_PORT="1433"
DB_NAME="DocuFlowDB"
DB_USER=""
DB_PASSWORD=""

# Alternative full database URL (optional override)
# Example: mssql+pyodbc://sa:YourPassword@localhost:1433/DocuFlowDB?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
DATABASE_URL=""

# JWT Authentication & Session Security
SECRET_KEY="your-corporate-jwt-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # Default: 30 days session validity

# CORS Configuration (Comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# File Storage & Upload Directories
PDF_STORAGE_PATH="./stored_pdfs"
APPROVED_PDF_PATH="./stored_pdfs/approved"
UPLOAD_DIR="./backend/uploads"

# Server Bind Settings
PORT=3000
HOST="0.0.0.0"
