# DAAS - Document Approval Automation System Environment Configuration
# Copy this file to .env and configure environment parameters for your deployment.

# General Application Settings
PROJECT_NAME="DocuFlow Automation System"
ENVIRONMENT="production"  # Options: development, staging, production
LOG_LEVEL="INFO"          # Options: DEBUG, INFO, WARNING, ERROR

# Database Connection (DocuFlowDB on MS SQL Server 192.168.179.22)
# MS SQL Server Example: mssql+pyodbc://@192.168.179.22/DocuFlowDB?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
DATABASE_URL="mssql+pyodbc://@192.168.179.22/DocuFlowDB?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes"

# JWT Authentication & Session Security
SECRET_KEY="your-corporate-jwt-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # Default: 30 days session validity

# CORS Configuration (Comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# File Storage & Upload Directories
PDF_STORAGE_PATH="./stored_pdfs"
APPROVED_PDF_PATH="./stored_pdfs/approved"
UPLOAD_DIR="./backend/uploads"

# Server Bind Settings
PORT=3000
HOST="0.0.0.0"
